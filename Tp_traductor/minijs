<Programa> ::= <Sentencia> | <Sentencia> <Programa>
<Sentencia> ::= <Declaracion> | <Impresion>
<Declaracion> ::= let <Variable> = <Expresion>; | const <Variable> = <Expresion>;
<Impresion> ::= console.log ( <Expresion> );
<Expresion> ::= <Variable> | <Digito> | <Expresion> + <Expresion> | <Expresion> - <Expresion> | <Expresion> * <Expresion> | <Expresion> / <Expresion>
<Variable> ::= <Letra> | <Variable><Letra> | <Variable><Digito>
<Letra> ::= a | b | c | ... | z
<Digito> ::= 0 | 1 | 2 | ... | 9

